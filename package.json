{
  "name": "event-horizon",
  "productName": "Event Horizon",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/convex-worktree.ts --dev",
    "dev:react": "vite",
    "dev:convex": "convex dev --env-file .env.local",
    "dev:electron": "npm run transpile:electron; NODE_ENV=development ELECTRON_RUN_AS_NODE= electron .",
    "typecheck:electron": "tsc --project src/electron/tsconfig.json --noEmit",
    "build": "npm run typecheck:electron && tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "generate:icons": "bash scripts/generate-icons.sh",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "dist:mac": "npm run transpile:electron && npm run build && electron-builder --mac --arm64 --publish never",
    "release": "node --experimental-strip-types scripts/release.ts",
    "release:publish": "node --experimental-strip-types scripts/release-publish.ts",
    "typecheck:release": "tsc --project scripts/tsconfig.json",
    "dist:win": "npm run transpile:electron && npm run build && electron-builder --win --publish never",
    "dist:release": "npm run transpile:electron && npm run build && electron-builder --mac --win --publish never",
    "convex:worktree": "node --experimental-strip-types scripts/convex-worktree.ts",
    "google-calendar:auth": "node --experimental-strip-types scripts/google-calendar-auth.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "@workos-inc/node": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.51.0",
    "electron-updater": "^6.8.11",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.516.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-router": "^7.18.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@electron/asar": "^3.4.1",
    "@eslint/js": "^9.25.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "convex-test": "^0.0.60",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.0.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.3.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get@3.1.0": {
        "global-agent": "4.1.3"
      }
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    },
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  }
}
