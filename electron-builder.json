{
    "appId": "com.latenightcreation.event-horizon",
    "productName": "Event Horizon",
    "artifactName": "Event-Horizon-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026",
    "files": ["dist-electron", "dist-react"],
    "icon": "./src/assets/eventHorizon.icns",
    "mac": {
        "target": [
            { "target": "dmg", "arch": ["arm64"] },
            { "target": "zip", "arch": ["arm64"] }
        ],
        "category": "public.app-category.productivity",
        "hardenedRuntime": true,
        "gatekeeperAssess": false,
        "forceCodeSigning": true,
        "identity": "LNC Internal Signature",
        "entitlements": "build/entitlements.mac.plist",
        "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
        "contents": [
            { "x": 130, "y": 220 },
            { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
        ]
    },
    "publish": {
        "provider": "github",
        "owner": "able312",
        "repo": "event_horizon",
        "private": false,
        "releaseType": "draft"
    }
}
